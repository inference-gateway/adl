{
  "name": "adl-docs",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": ".vitepress/dist",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "adl.inference-gateway.com", "custom_domain": true }],
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
  },
}
